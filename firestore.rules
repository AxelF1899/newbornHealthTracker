rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function babyOwned() {
      return signedIn() && resource.data.usuarioId == request.auth.uid;
    }

    function babyCreateOwned() {
      return signedIn() && request.resource.data.usuarioId == request.auth.uid;
    }

    match /nbht_user/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'nombre',
          'apellido',
          'email',
          'telefono',
          'fechaNacimiento'
        ])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    match /nbht_baby/{babyId} {
      allow read: if babyOwned();
      allow create: if babyCreateOwned();
      allow update: if babyOwned() && babyCreateOwned();
      allow delete: if babyOwned();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
